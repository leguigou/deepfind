# crontab -u www-data -e
# Les horaires d'import se règlent dans l'extranet (Flux & mapping › Planification des imports).
# Le planificateur ci-dessous vérifie chaque minute s'il y a un import à lancer.

# Avec Supervisor (recommandé : deploy/supervisor-worker.conf traite les imports)
* * * * *     /usr/bin/php8.5 /var/www/deepfind/bin/console schedule:run >> /var/log/deepfind-import.log 2>&1
# Sans Supervisor : remplacez la ligne précédente par celle-ci (planifie ET exécute)
# * * * * *   /usr/bin/php8.5 /var/www/deepfind/bin/console schedule:run --work >> /var/log/deepfind-import.log 2>&1

# Purge des journaux de recherche (durée de conservation réglable dans l'extranet)
40 4 * * *    /usr/bin/php8.5 /var/www/deepfind/bin/console logs:purge >> /var/log/deepfind-import.log 2>&1
