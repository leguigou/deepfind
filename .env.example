# ============================================================ DeepFind — configuration
# Copiez ce fichier en .env puis complétez. Ne versionnez JAMAIS le fichier .env.

APP_ENV=prod
# URL publique du service (sert dans l'extranet pour le code d'intégration)
APP_URL=https://search.cabesto.com
# Si l'application est installée dans un sous-dossier (ex. /search), sinon laisser vide
APP_BASE_PATH=
APP_TIMEZONE=Europe/Paris
# Langues gérées (la première est la langue par défaut de l'extranet)
APP_LANGS=fr

# Jeton d'accès à l'extranet (32 caractères minimum) et secret interne : php bin/console admin:token
ADMIN_TOKEN=
APP_SECRET=

# ------------------------------------------------------------ MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=deepfind
DB_USER=deepfind
DB_PASS=

# ------------------------------------------------------------ Meilisearch
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=
# Facultatif : clé « search » dédiée (sinon la master key est utilisée côté serveur, jamais exposée au navigateur)
MEILI_SEARCH_KEY=
MEILI_INDEX_PREFIX=deepfind_
MEILI_TIMEOUT=2

# ------------------------------------------------------------ Anti-robots / cache
# apcu (recommandé, 1 serveur) | redis (plusieurs serveurs) | mysql (repli)
RATE_STORE=apcu
REDIS_URL=redis://127.0.0.1:6379/0
# Si un proxy/CDN/load balancer est devant Apache : ses IP (séparées par des virgules, CIDR accepté)
TRUSTED_PROXIES=

# ------------------------------------------------------------ Import des flux
# Dossiers autorisés pour les flux en chemin local (relatifs au projet ou absolus)
FEED_LOCAL_DIRS=var/feeds-local,samples
FEED_DOWNLOAD_TIMEOUT=900
